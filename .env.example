# Aquaflow frontend env
#
# Vite loads by mode:
#   npm run dev   → .env.development (+ optional .env.development.local)
#   npm run build → .env.production  (+ optional .env.production.local)
#
# Do not put secrets here — VITE_* values are public in the browser bundle.
# Hostinger: set VITE_API_URL in the frontend project env panel (or rely on .env.production).

VITE_API_URL=http://localhost:3001
